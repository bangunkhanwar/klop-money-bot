{
  "name": "klop-money-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API dan chatbot WhatsApp Klop Money",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:api": "node src/index.js --api-only",
    "dev": "node src/index.js",
    "dev:watch-api": "node --watch src/index.js --api-only",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/bot/whatsapp.js && node --check src/services/googleSheetsService.js && node --check src/services/googleSheetsQuery.js",
    "setup:sheets": "node scripts/setupSheets.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  }
}
